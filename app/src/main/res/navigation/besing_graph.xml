<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/besing_graph"
    app:startDestination="@id/besinListesiFragment">

    <fragment
        android:id="@+id/besinDetayiFragment"
        android:name="com.atilsamancioglu.besinlerkitabigradlework.view.BesinDetayiFragment"
        android:label="BesinDetayiFragment" >
        <action
            android:id="@+id/action_besinDetayiFragment_to_besinListesiFragment"
            app:destination="@id/besinListesiFragment" />
        <argument
            android:name="besinId"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>
    <fragment
        android:id="@+id/besinListesiFragment"
        android:name="com.atilsamancioglu.besinlerkitabigradlework.view.BesinListesiFragment"
        android:label="BesinListesiFragment" >
        <action
            android:id="@+id/action_besinListesiFragment_to_besinDetayiFragment"
            app:destination="@id/besinDetayiFragment" />
        <action
            android:id="@+id/action_besinListesiFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.atilsamancioglu.besinlerkitabigradlework.view.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.atilsamancioglu.besinlerkitabigradlework.view.RegisterFragment"
        android:label="RegisterFragment" />
</navigation>